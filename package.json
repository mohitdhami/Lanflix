{
  "name": "lanflix-local-netflix",
  "version": "1.0.0",
  "description": "LanFlix — Netflix clone for your local LAN. Direct-play streaming + local CRM.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "scan": "node -e \"require('./src/scanner').scanMedia(true)\"",
    "reset": "node -e \"require('./src/db').resetDb(); require('./src/seed').seed(true)\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  }
}
